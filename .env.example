# Port the Express server (and static frontend in production) listens on
PORT=3000

# Path to the OpenSCAD executable. In the Docker image this points at the
# xvfb wrapper script so OpenSCAD can run headlessly without a display.
OPENSCAD_BIN=openscad

# Max upload size for SVG/STL assets, in bytes
MAX_UPLOAD_BYTES=5242880

# Max age (ms) a file in /uploads, /output, /temp may live before cleanup sweeps it
FILE_TTL_MS=3600000

# Max time (ms) a single OpenSCAD compile may run before being killed.
# Full-quality renders with a beaded border and/or a detailed uploaded
# graphic can take 20s+ even for a single token.
OPENSCAD_TIMEOUT_MS=180000

# CORS origin allowed to hit the API in development (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
